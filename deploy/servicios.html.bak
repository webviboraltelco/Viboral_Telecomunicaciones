<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link rel="stylesheet" href="build/css/app.css?v=2" />
    <title>Viboral Telecomunicaciones</title>
    <link rel="icon" type="image/x-icon" href="build/img/logo.png" />
  </head>
  <body>
   <header class="header " id="header">  
  <div class="contenedor contenido">

    <div class="barra">

      <!-- Logo -->
      <a href="/" class="barra__logo">
        <img src="build/img/logocanal.webp" alt="Viboral Telecomunicaciones" />
      </a>

      <!-- ✅ Nav DENTRO de .barra para que esté en la misma fila -->
      <nav class="navegacion" id="navegacion">
        <a href="nosotros.html"><i class="fas fa-users"></i><span>Nosotros</span></a>
        <a href="planes.html"><i class="fas fa-wifi"></i><span>Planes</span></a>
        <a href="canal.html"><i class="fas fa-tv"></i><span>Canal Local</span></a>
        <a href="contacto.html"><i class="fas fa-envelope"></i><span>Contáctanos</span></a>
        <a href="https://pse.viboraltelecomunicaciones.com/" target="_blank" rel="noopener">
          <i class="fas fa-credit-card"></i><span>Pagos</span>
        </a>
        <a href="#" class="nav-btn-oficina">
          <i class="fas fa-laptop-house"></i><span>Oficina Virtual</span>
        </a>
      </nav>

      <!-- Acciones: solo visibles en móvil -->
      <div class="barra__acciones">
        <button class="dark-mode-boton" aria-label="Modo oscuro">
          <img src="build/img/dark.png" alt="Modo oscuro" />
        </button>
        <button class="mobile-menu" id="mobileMenu" 
                aria-label="Abrir menú" aria-expanded="false">
          <span class="hamburguesa">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>

    </div><!-- .barra -->
  </div>
</header>

    <main class="contenedor seccion">
      <h1>Servicios</h1>
    </main>

    <footer class="footer-futurista">
      <div class="contenedor-footer">
        <!-- LOGO -->
        <div class="logo-footer">
          <a href="/">
            <img src="build/img/logo.png" alt="Viboral Telecomunicaciones" />
          </a>
        </div>

        <!-- REDES -->
        <div class="redes-footer">
          <h3 class="titulo-footer">Conéctate con nosotros</h3>

          <div class="redes-sociales">
            <a href="#" class="icon facebook">
              <i class="fab fa-facebook-f"></i>
            </a>

            <a href="#" class="icon instagram">
              <i class="fab fa-instagram"></i>
            </a>

            <a href="https://wa.me/573147258728" class="icon whatsapp">
              <i class="fab fa-whatsapp"></i>
            </a>

            <a href="#" class="icon waze">
              <i class="fab fa-waze"></i>
            </a>

            <a
              href="mailto:soporte@viboraltelecomunicaciones.com"
              class="icon correo"
            >
              <i class="fas fa-envelope"></i>
            </a>
          </div>
        </div>

        <!-- LINKS LEGALES -->
        <div class="documentos-legales">
          <h3 class="titulo-legales">Documentos legales</h3>

          <div class="links-legales">
            <a href="derecho-asociado.html">Derecho del Asociado</a>
            <a href="politica-cookies.html">Política de cookies</a>
            <a href="norma-estatutaria.html">Norma Estatutaria</a>
          </div>
        </div>
      </div>

      <!-- COPYRIGHT -->
      <div class="copyright">
        Viboral Telecomunicaciones © 2026 Todos los derechos reservados
    <span class="creador-sitio">
      · Creado y desarrollado por
      <a href="https://cv-sebastian-mu.vercel.app/" target="_blank" rel="noopener">js.dev</a>
    </span>
      </div>
    </footer>

    <script src="build/js/bundle.min.js"></script>
  </body>
</html>
